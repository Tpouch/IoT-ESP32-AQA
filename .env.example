# Copy to .env (gitignored) and fill in. Read at build time by tools/load_env.py.
# Any key left out keeps its default from src/utils/secrets.h.
# Values may be quoted: WIFI_PASSWORD="with spaces"

WIFI_SSID=CHANGE_ME
WIFI_PASSWORD=CHANGE_ME

