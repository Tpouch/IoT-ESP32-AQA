# Copy to .env (gitignored) and fill in. Read at build time by tools/load_env.py.
# Any key left out keeps its default from src/utils/secrets.h.
# Values may be quoted: WIFI_PASSWORD="with spaces"

WIFI_SSID=CHANGE_ME
WIFI_PASSWORD=CHANGE_ME

# WPA2/WPA3-Enterprise (802.1X, PEAP + MSCHAPv2), e.g. eduroam or a residence
# network. Setting WIFI_EAP_USERNAME switches to enterprise mode; WIFI_PASSWORD
# is then ignored.
# WIFI_EAP_USERNAME=login
# WIFI_EAP_PASSWORD=secret
# WIFI_EAP_IDENTITY=           # "anonymous identity"; empty = username
# WIFI_EAP_CA_FILE=certs/ca.pem  # optional: verify the RADIUS server (recommended)

# MQTT_BROKER=192.168.1.10
# MQTT_PORT=1883
# MQTT_USERNAME=student
# MQTT_PASSWORD=student

# GEOHASH_DEFAULT=d347
# FIRMWARE_URL=http://192.168.1.10:8000/firmware.bin
# FIRMWARE_SIG_URL=http://192.168.1.10:8000/firmware.sig
